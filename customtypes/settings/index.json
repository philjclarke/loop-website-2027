    "Main": {
      "site_name": {
        "config": {
          "label": "Site name",
          "placeholder": "loop"
        },
        "type": "Text"
      },
      "navigation": {
        "config": {
          "allowText": true,
          "label": "Navigation",
          "repeat": true
        },
