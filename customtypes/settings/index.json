        "type": "StructuredText"
      },
      "cta_link": {
        "config": {
          "allowText": true,
          "label": "Footer CTA button"
        },
        "type": "Link"
      },
      "email": {
        "config": {
          "label": "Contact email"
        },
        "type": "Text"
      },
      "social_links": {
        "config": {
          "allowTargetBlank": true,
          "allowText": true,
          "label": "Social links",
          "repeat": true,
          "select": "web"
        },
        "type": "Link"
      },
      "legal_links": {
        "config": {
          "allowText": true,
          "label": "Legal links",
          "repeat": true
        },
        "type": "Link"
