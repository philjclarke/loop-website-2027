# Copy to .env.local for local development, and add the same values in Vercel
# (Project → Settings → Environment Variables).

# Contact form (sent with Resend: https://resend.com)
# Without RESEND_API_KEY, submissions are logged to the console in development.
RESEND_API_KEY=
# Must be on a domain verified in Resend
CONTACT_FROM_EMAIL="loop website <website@loopdesign.org>"
# Optional: defaults to the contact email on the Settings document in Prismic
CONTACT_TO_EMAIL=

# Optional: shared secret for the Prismic webhook that calls /api/revalidate
PRISMIC_WEBHOOK_SECRET=
